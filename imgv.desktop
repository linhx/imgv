[Desktop Entry]
Name=imgv
GenericName=Image Viewer
Comment=High-Performance Image Viewer & Animated Player (GIF, WebP, APNG, SVG, JPG, PNG)
Exec=imgv %f
Icon=imgv
Terminal=false
Type=Application
Categories=Graphics;Viewer;2DGraphics;Photography;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/png;image/tiff;image/webp;image/x-bmp;image/x-png;image/avif;image/svg+xml;
Keywords=image;picture;viewer;gallery;gif;webp;apng;photo;
StartupNotify=true
